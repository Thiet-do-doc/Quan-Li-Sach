<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · BookManagement</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container nav">
            <a class="brand" asp-controller="Books" asp-action="Index"><span class="brand-icon">B</span> BookManagement</a>
            <nav aria-label="Điều hướng chính">
                <a asp-controller="Books" asp-action="Index">Danh sách sách</a>
                <a asp-controller="Home" asp-action="Database">Kiểm tra CSDL</a>
            </nav>
        </div>
    </header>
    <main class="container main">
        @if (TempData["Success"] is string message)
        {
            <div class="alert success" role="status">@message</div>
        }
        @RenderBody()
    </main>
    <footer class="container footer">BookManagement · Ứng dụng quản lý sách</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
