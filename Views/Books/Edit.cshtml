@model BookFormViewModel
@{ ViewData["Title"] = "Sửa sách"; }
<div class="page-header"><div><p class="eyebrow">CẬP NHẬT THÔNG TIN</p><h1>Sửa sách</h1><p class="muted">Chỉnh sửa thông tin và lưu thay đổi.</p></div></div>
<section class="card form-card">
    <form asp-action="Edit" asp-route-id="@ViewData["BookId"]" method="post">
        <partial name="_BookForm" model="Model" />
        <div class="form-actions"><button type="submit" class="btn primary">Lưu thay đổi</button><a class="btn light" asp-action="Index">Hủy</a></div>
    </form>
</section>
