@model Book
@{ ViewData["Title"] = "Chi tiết sách"; }
<div class="page-header"><div><p class="eyebrow">CHI TIẾT SÁCH #@Model.Id</p><h1>@Model.Title</h1></div></div>
<section class="card form-card">
    <partial name="_BookDetails" model="Model" />
    <div class="form-actions"><a class="btn primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa sách</a><a class="btn light" asp-action="Index">Quay lại</a></div>
</section>
