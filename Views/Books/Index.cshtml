@model BookIndexViewModel
@{ ViewData["Title"] = "Danh sách sách"; }
<section class="page-header">
    <div><p class="eyebrow">THƯ VIỆN CỦA BẠN</p><h1>Quản lý sách</h1><p class="muted">Có @Model.TotalBooks đầu sách trong thư viện.</p></div>
    <a class="btn primary" asp-action="Create">+ Thêm sách mới</a>
</section>
<section class="card">
    <form asp-action="Index" method="get" class="filters">
        <div class="search-field"><label for="search">Tên sách hoặc tác giả</label><input id="search" name="search" value="@Model.Search" maxlength="100" placeholder="Nhập từ khóa tìm kiếm..." /></div>
        <div><label for="genre">Thể loại</label><select id="genre" name="genre"><option value="">Tất cả thể loại</option>
            @foreach (var genre in Model.Genres)
            {
                <option value="@genre" selected="@(genre == Model.Genre)">@genre</option>
            }
        </select></div>
        <button class="btn primary" type="submit">Tìm kiếm</button>
        <a class="btn light" asp-action="Index">Đặt lại</a>
    </form>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Sách / Tác giả</th><th>Thể loại</th><th>Năm</th><th class="number">Giá bán</th><th class="number">Số lượng</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td><a class="book-title" asp-action="Details" asp-route-id="@book.Id">@book.Title</a><div class="muted small">@book.Author</div></td>
                    <td><span class="badge">@book.Genre</span></td><td>@book.PublishedYear</td>
                    <td class="number">@book.Price.ToString("N2", CultureInfo.GetCultureInfo("vi-VN")) ₫</td>
                    <td class="number">@book.Quantity</td>
                    <td class="actions"><a asp-action="Details" asp-route-id="@book.Id">Xem</a><a asp-action="Edit" asp-route-id="@book.Id">Sửa</a><a class="danger-text" asp-action="Delete" asp-route-id="@book.Id">Xóa</a></td>
                </tr>
            }
            @if (Model.Books.Count == 0)
            {
                <tr><td colspan="6" class="empty">Không tìm thấy sách. Hãy đổi bộ lọc hoặc thêm sách mới.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="pagination">
        <span class="muted">@Model.FilteredCount kết quả · Trang @Model.Page / @Model.TotalPages</span>
        <div>
            @if (Model.Page > 1) { <a class="btn light" asp-action="Index" asp-route-search="@Model.Search" asp-route-genre="@Model.Genre" asp-route-page="@(Model.Page - 1)">← Trước</a> }
            @if (Model.Page < Model.TotalPages) { <a class="btn light" asp-action="Index" asp-route-search="@Model.Search" asp-route-genre="@Model.Genre" asp-route-page="@(Model.Page + 1)">Sau →</a> }
        </div>
    </div>
</section>
