@model BookFormViewModel
<div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="form-grid">
    <div class="wide"><label asp-for="Title"></label><input asp-for="Title" maxlength="200" required placeholder="Ví dụ: Dế Mèn phiêu lưu ký" /><span asp-validation-for="Title" class="validation"></span></div>
    <div><label asp-for="Author"></label><input asp-for="Author" maxlength="120" required /><span asp-validation-for="Author" class="validation"></span></div>
    <div><label asp-for="Genre"></label><input asp-for="Genre" maxlength="80" required list="genreSuggestions" /><datalist id="genreSuggestions"><option value="Văn học"></option><option value="Tiểu thuyết"></option><option value="Công nghệ"></option><option value="Kỹ năng"></option><option value="Khoa học"></option></datalist><span asp-validation-for="Genre" class="validation"></span></div>
    <div><label asp-for="Publisher"></label><input asp-for="Publisher" maxlength="150" /><span asp-validation-for="Publisher" class="validation"></span></div>
    <div><label asp-for="PublishedYear"></label><input asp-for="PublishedYear" type="number" min="1000" max="2100" required /><span asp-validation-for="PublishedYear" class="validation"></span></div>
    <div><label asp-for="Price"></label><input asp-for="Price" type="number" min="0" max="999999999" step="0.01" required /><span asp-validation-for="Price" class="validation"></span></div>
    <div><label asp-for="Quantity"></label><input asp-for="Quantity" type="number" min="0" max="1000000" required /><span asp-validation-for="Quantity" class="validation"></span></div>
    <div class="wide"><label asp-for="Description"></label><textarea asp-for="Description" rows="4" maxlength="2000" placeholder="Giới thiệu ngắn về nội dung sách..."></textarea><span asp-validation-for="Description" class="validation"></span></div>
</div>
